## Release signing template.
## 1. Generate a keystore (once, keep it safe — losing it means losing the
##    ability to update the app under the same signature):
##      keytool -genkey -v -keystore medguard-release.jks -keyalg RSA \
##        -keysize 2048 -validity 10000 -alias medguard
## 2. Copy this file to key.properties (gitignored) and fill in the values.
storeFile=../medguard-release.jks
storePassword=CHANGE_ME
keyAlias=medguard
keyPassword=CHANGE_ME
