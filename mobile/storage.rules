rules_version = '2';

// MedGuard Cloud Storage security rules.
//
// No files are uploaded by the shipped app. This is the locked default:
// only a signed-in user may access objects under their own uid prefix, and
// everything else is denied. Never leave Storage in open "test mode".
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
