# Large source-of-truth model artifacts — recreate with the training script.
models/rf_severity_model.joblib

# Intermediate Keras model — only an input to TFLite conversion, never loaded at
# runtime; regenerated by convert_tflite.py.
models/*.keras

# Generated evaluation plot — the tracked confusion_matrix.csv is the source of
# truth; the PNG is a regenerable render.
reports/confusion_matrix.png

# Interim feature matrix can be regenerated from CSVs in data/processed/.
data/interim/features_matrix.csv

# Pipeline data splits (regeneratable from the feature matrix).
data/processed/train.csv
data/processed/val.csv
data/processed/test.csv
